# Run commands from the bug-bounty-ai directory. Never commit .env.
DATABASE_URL=sqlite:///data/bugbounty.db
DATA_DIR=data
# PostgreSQL alternative (create database/user separately):
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/bugbounty

# Blank values generate persistent mode-0600 files in DATA_DIR on first start.
API_TOKEN=
ENCRYPTION_KEY=
# Keep the encryption key with database backups. Losing it loses test credentials.

# Off by default. Only enable for environments you own. This allows loopback,
# NOT private RFC1918, metadata or link-local addresses.
ALLOW_LOOPBACK_TARGETS=false
FRONTEND_DIR=frontend/dist

# OpenAI-compatible /v1 base URL. Blank means AI disabled, not simulated.
# A loopback endpoint can receive redacted evidence for local analysis.
# Remote endpoints receive only generic app-authored detector metadata.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Example local model server: http://127.0.0.1:11434/v1

# Optional read-only official program integrations. No automatic submissions.
HACKERONE_USERNAME=
HACKERONE_TOKEN=
# Bugcrowd uses token-id:token-secret (not just the secret).
BUGCROWD_TOKEN=
INTIGRITI_TOKEN=

# Your own HTTPS public origin routing ONLY /api/callback/* to this app.
# Do not expose the dashboard or other API routes to the public Internet.
# An external reverse proxy/TLS setup is required for external target callbacks.
CALLBACK_BASE_URL=
